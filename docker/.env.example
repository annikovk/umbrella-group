# Образец локальных настроек стенда. tools/local-site.sh создаёт из него
# docker/.env при первом запуске и подставляет uid/gid текущего пользователя.
# Файл .env в git не едет; секретов здесь нет — пароль базы локальный.

# Порт сайта. 8080 на этой машине занят дашбордом, поэтому 8088.
HTTP_PORT=8088

# Порт MariaDB для внешних клиентов (TablePlus, Sequel Ace): localhost:3307.
DB_PORT=3307

# Apache внутри контейнера работает под этим uid/gid — иначе не прочитает
# зеркало (права 750 на владельце-человеке). Подставляются автоматически.
HOST_UID=501
HOST_GID=20

DB_NAME=wp_taxlab
DB_ROOT_PASSWORD=local

# 1 — включить WP_DEBUG и SCRIPT_DEBUG (ошибки идут в docker compose logs).
WP_DEBUG=0
